// This is your Prisma schema file.
// Architecture specifies MySQL for production, but SQLite is used here for rapid local prototyping without external dependencies.
// To switch to MySQL, change provider to "mysql" and update the DATABASE_URL in .env.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String      @id @default(uuid())
  name      String
  email     String      @unique
  password  String
  role      String      @default("EMPLOYEE") // "ADMIN" or "EMPLOYEE"
  isActive  Boolean     @default(true) // For Soft Delete
  workspaces Workspace[] @relation("UserWorkspaces")
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model Workspace {
  id              String   @id @default(uuid())
  name            String
  cloudPath       String   // e.g., "Google Drive/Contabilidad"
  defaultPassword String   // "Secure by Default" base password
  users           User[]   @relation("UserWorkspaces")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model SecurityPolicy {
  id          String   @id @default(uuid())
  type        String   // "SEMANTIC" (Text/OCR) or "VISUAL" (Template Matching)
  target      String   // Keyword, exact sentence, or visual template identifier
  password    String   // Cryptographic replacement password
  priority    Int      @default(0) // Used for resolving conflicts (Visión > Texto)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  details   String
  status    String   // "SUCCESS" or "FAILURE"
  createdAt DateTime @default(now())
}
